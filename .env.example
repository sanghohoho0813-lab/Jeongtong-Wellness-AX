# Supabase 프로젝트 → Settings → API 에서 복사한다.
# 이 두 값은 브라우저에 노출되어도 되는 값이다. 실제 보호는 RLS 가 한다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable 또는 anon 키>

# service_role / secret 키는 이 파일에도, 코드에도 절대 넣지 않는다.

# ---------------------------------------------------------
# 체험(Demo) 모드
#
# 넣지 않으면 실제 운영 모드다 — 로그인해야 직원 화면이 열리고,
# 내가 누구인지는 서버(staff.auth_user_id → role)가 정한다.
#
# 1 로 켜면 로그인 없이 가상 자료로 화면을 둘러볼 수 있고,
# 사이드바에서 직원(역할)을 바꿔 볼 수 있다. 시연·연습용이다.
# 실제 고객자료는 서버에 있고 서버는 로그인해야 열리므로,
# Demo 주소로는 실제 개인정보에 닿을 길이 없다.
# ---------------------------------------------------------
# NEXT_PUBLIC_DEMO_MODE=1
